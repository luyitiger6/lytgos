<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lytgos-web</artifactId>
    <name>lytgos-web</name>
    <description>REST 接入：会话、Agent 调用、记忆与工具查询端点</description>

    <dependencies>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- HTTP 接入层：控制器、统一响应体与全局异常都编译在本模块 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康探针与指标端点；版本由 Spring Boot 父 pom 管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- prod profile 的单行 JSON 日志编码器 -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
        <!-- OpenAPI 3 文档与 Swagger UI，版本由根 pom dependencyManagement 锁定 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 把 MockMvc 测试支持从 spring-boot-test-autoconfigure 拆到了
            spring-boot-webmvc-test（org.springframework.boot.webmvc.test.autoconfigure.
            AutoConfigureMockMvc），版本由父 pom 管理。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                门禁五件套：插件声明在模块里，任一模块在自己的目录即可 `mvn verify` 独立验收；
                版本、配置与 execution 绑定由根 pom 的 pluginManagement 统一提供。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>
            <!-- 把 Implementation-Version 写进 jar 清单：system/info 的版本字段由此而来 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
