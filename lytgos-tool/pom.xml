<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lytgos-tool</artifactId>
    <name>lytgos-tool</name>
    <description>工具：内置工具实现、MCP 客户端与沙箱校验</description>

    <dependencies>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            MCP 官方 Java SDK。刻意不引 spring-ai-mcp：它会把 spring-ai-model 带进来，
            而 AGENTS.md 4.1 只允许 lytgos-provider 依赖 Spring AI（04 闸门会扫）。
            spring-ai-mcp:2.0.2 内部依赖的正是这个版本，直接对齐便于将来一起升级。
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>${mcp-sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
