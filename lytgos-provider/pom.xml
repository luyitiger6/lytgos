<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lytgos-provider</artifactId>
    <name>lytgos-provider</name>
    <description>模型接入：Provider 显式映射与各家协议转换</description>

    <dependencies>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          用 spring-ai-openai 而不是 spring-ai-starter-model-openai：
          starter 会带入自动配置，在 classpath 上凭空多出一个 ChatModel bean，
          正是 AGENTS.md 4.2 禁止的「配置驱动退化成 classpath 驱动」。
          这里只取协议转换与 schema 生成能力，模型实例全部由 ProviderRegistry 显式构造。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
    </dependencies>
</project>
