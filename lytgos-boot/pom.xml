<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lytgos-boot</artifactId>
    <name>lytgos-boot</name>
    <description>启动装配：主类、自动配置与模块聚合</description>

    <dependencies>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-persona</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-tool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-channel-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>lytgos</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
