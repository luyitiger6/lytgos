<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.lytgos</groupId>
    <artifactId>lytgos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>lytgos</name>
    <description>企业级 Agent OS 控制面</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <!-- 与 spring-ai-mcp:2.0.2 内部依赖的版本保持一致，便于将来一起升级 -->
        <mcp-sdk.version>2.1.0</mcp-sdk.version>
        <!--
            springdoc-openapi 2.x 只兼容 Spring Boot 3，支持 Boot 4 的是 3.x 线（官方兼容矩阵）。
            3.2.0 为 2026-10 的当前 release；升级 Spring Boot 时同步复核本项。
        -->
        <springdoc.version>3.2.0</springdoc.version>
        <!--
            swagger-ui 是 springdoc 的传递依赖（3.2.0 → swagger-ui 5.34.0），后者内嵌的
            DOMPurify 3.4.16 命中 CVE-2026-116803 / CVE-2026-116804（均 CVSS 10.0）。
            5.35.0 的 bundle 内为 DOMPurify 3.4.17（修复版本）。这里覆盖传递版本：
            swagger-ui 是纯前端静态资源，不影响 springdoc 生成 API 文档的服务端逻辑。
        -->
        <swagger-ui.version>5.35.0</swagger-ui.version>
        <!--
            Spring Boot 4 的 dependencyManagement 不再含 logstash-logback-encoder（Boot 3 时代曾管理），
            不显式锁版本则子模块引用时报 version is missing。9.0 兼容 logback 1.5.x。
        -->
        <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
        <!--
            Kotlin 运行时传递依赖（openai-java / okhttp-okio 带入）：2.3.21 命中 CVE-2026-53914
            （CVSS 9.8，build cache 元数据不安全反序列化，修复于 2.4.20），覆盖 Spring Boot 父 pom 管理的版本。
            kotlin-stdlib-common 自 Kotlin 2.0 起停发、没有 2.4.20，由 lytgos-provider 在 spring-ai-openai 上排除。
        -->
        <kotlin.version>2.4.20</kotlin.version>
        <archunit.version>1.4.1</archunit.version>
        <!-- 格式门禁：google-java-format 1.27.0 起支持 JDK 21 -->
        <spotless.version>2.44.5</spotless.version>
        <google-java-format.version>1.27.0</google-java-format.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <!-- p3c-pmd 2.1.1 编译于 PMD 6 API，故插件与 PMD 都锁 6.x 线 -->
        <maven-pmd-plugin.version>3.21.2</maven-pmd-plugin.version>
        <p3c-pmd.version>2.1.1</p3c-pmd.version>
        <pmd.version>6.55.0</pmd.version>
        <!-- PMD 6.55 自带的 ASM 只认到 Java 20 字节码（major 64），读 JDK21 编译产物会整体解析失败，覆盖到 9.7.1 -->
        <asm.version>9.7.1</asm.version>
        <!-- 默认阻断；本地排查存量违规时可用 -Dpmd.failOnViolation=false 先收集全量清单 -->
        <pmd.failOnViolation>true</pmd.failOnViolation>
        <!-- 静态缺陷与安全扫描：SpotBugs + FindSecBugs -->
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <!-- 默认阻断；本地排查存量问题时可用 -Dspotbugs.failOnError=false 先收集全量报告 -->
        <spotbugs.failOnError>true</spotbugs.failOnError>
        <!--
            依赖漏洞门禁：默认跳过，由 security profile 启用（spec 要求独立 profile、默认构建不执行）。
            NVD 数据首次下载以分钟计，日常逐模块 verify 不跑；CI 必跑 security profile。
            实测 13.0.0 在无 NVD API key 的环境直接报 Invalid API Key 无法初始化，故锁 12.x。
        -->
        <dependency-check-maven.version>12.2.2</dependency-check-maven.version>
        <dependency-check.skip>true</dependency-check.skip>
        <!--
            SQLite JDBC 驱动。只取驱动：审计与会话是固定 SQL，连接池由装配层（Spring）提供。
        -->
        <sqlite-jdbc.version>3.47.1.0</sqlite-jdbc.version>
        <!--
            持久化选型是 MyBatis：storage 只引核心包（Mapper 接口 + XML），
            SqlSessionFactory 与数据源由 Spring 容器创建，见 lytgos-cli 的 CoreBeans。
        -->
        <mybatis.version>3.5.19</mybatis.version>
        <!--
            mybatis-spring 4.1.0 面向 Spring Framework 7.0.x（与 Boot 4.1 同代），
            低版本（3.x）编译于 Spring 6 API，不保证能在 Spring 7 下工作。
        -->
        <mybatis-spring.version>4.1.0</mybatis-spring.version>
        <!-- NVD 数据目录属性化：CI 缓存它，避免每次重新下载 -->
        <dependency-check.dataDirectory>${user.home}/.m2/dependency-check-data</dependency-check.dataDirectory>
        <!--
            NVD 数据源走 NIST 官方 JSON feeds 2.0（1.1 feeds 已退役返回 403）：不需要 API key。
            REST API 2.0 在本项目实测带有效 key 仍持续 503，分页到 10,000/425,753 条后无法继续。
        -->
        <dependency-check.nvdDatafeedUrl>https://nvd.nist.gov/feeds/json/cve/2.0/nvdcve-2.0-{0}.json.gz</dependency-check.nvdDatafeedUrl>
        <!--
            RetireJS 仓库默认从 raw.githubusercontent.com 拉取，国内网络经常无法解析（实测
            UnknownHostException）；缓存 24 小时过期后更新失败会让扫描器直接初始化失败、闸门恒红。
            改走 jsDelivr 的 GitHub 镜像：内容同源 Retirejs/retire.js 仓库，仅换分发通道。
        -->
        <dependency-check.retireJsUrl>https://cdn.jsdelivr.net/gh/Retirejs/retire.js@master/repository/jsrepository.json</dependency-check.retireJsUrl>
    </properties>

    <modules>
        <module>lytgos-core</module>
        <module>lytgos-persona</module>
        <module>lytgos-provider</module>
        <module>lytgos-memory</module>
        <module>lytgos-knowledge</module>
        <module>lytgos-tool</module>
        <module>lytgos-storage</module>
        <module>lytgos-runtime</module>
        <module>lytgos-channel</module>
        <module>lytgos-web</module>
        <module>lytgos-cli</module>
        <module>lytgos-boot</module>
        <module>lytgos-test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 架构约束测试只需要在 lytgos-test 里以 test scope 使用 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- OpenAPI 文档：UI 与 api-docs 同一 starter，版本在根 pom 统一锁定 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- MyBatis 核心包：storage 直接引，版本在根 pom 锁定 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- MyBatis-Spring：SqlSessionFactoryBean / @MapperScan，存储交给 Spring 容器管理 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>${mybatis-spring.version}</version>
            </dependency>
            <!--
                覆盖 springdoc 传递的 swagger-ui 5.34.0：其内嵌 DOMPurify 3.4.16 命中
                CVE-2026-116803 / CVE-2026-116804（CVSS 10.0），5.35.0 内为修复版 3.4.17。
            -->
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>swagger-ui</artifactId>
                <version>${swagger-ui.version}</version>
            </dependency>
            <!-- prod profile 的 JSON 日志编码器（Boot 4 BOM 不管它，见 properties 注释） -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        门禁插件只在这里定义一次（版本 + 配置 + execution 绑定），
        每个模块的 pom 显式声明这五个插件，因此任一模块都能在自己的目录里
        `mvn verify` 独立验收，而不是只有从根 reactor 跑才生效。
        共享配置一律用 ${project.basedir}/..：在子模块里求值指向仓库根，
        从根 reactor 构建时同样指向仓库根。
    -->
    <build>
        <pluginManagement>
            <plugins>
                <!--
                    格式门禁（SKILL 第 7 步）：google-java-format 管「长什么样」。
                    check 默认绑定 verify，mvn package / test 不受影响（harness 01/02 依赖这一点）。
                    行尾统一交给 .gitattributes（* text=auto eol=lf），与仓库现有约定一致。
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <lineEndings>GIT_ATTRIBUTES</lineEndings>
                        <java>
                            <googleJavaFormat>
                                <version>${google-java-format.version}</version>
                                <style>GOOGLE</style>
                            </googleJavaFormat>
                            <removeUnusedImports/>
                            <importOrder/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!--
                    规约兜底（SKILL 第 7 步）：google_checks.xml 与 google-java-format 同源，
                    格式由 gjf 先产出，Checkstyle 只补它没覆盖的检查（Javadoc、命名、圈复杂度）。
                    violationSeverity=warning：warning 级违规同样阻构建。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <configuration>
                        <configLocation>google_checks.xml</configLocation>
                        <suppressionsLocation>${project.basedir}/../config/checkstyle/suppressions.xml</suppressionsLocation>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>warning</violationSeverity>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    </configuration>
                    <executions>
                        <execution>
                            <id>checkstyle-check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!--
                    编码规约（SKILL 第 7 步）：阿里 P3C 挂在 PMD 上。
                    p3c-pmd 2.1.1 只能跑在 PMD 6 API 上，所以 maven-pmd-plugin 选 3.21.2
                    （最后一个默认 PMD 6 的版本），并显式锁定 pmd-java 6.55.0。
                    ruleset 用仓库内定制版：包含全部 10 组 ali 规则，仅排除 3 条与项目基线
                    冲突的规则，理由集中写在 config/pmd/p3c-ruleset.xml 顶部。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin.version}</version>
                    <configuration>
                        <targetJdk>20</targetJdk>
                        <rulesets>
                            <ruleset>${project.basedir}/../config/pmd/p3c-ruleset.xml</ruleset>
                        </rulesets>
                        <includeTests>true</includeTests>
                        <printFailingErrors>true</printFailingErrors>
                        <failOnViolation>${pmd.failOnViolation}</failOnViolation>
                        <linkXRef>false</linkXRef>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>com.alibaba.p3c</groupId>
                            <artifactId>p3c-pmd</artifactId>
                            <version>${p3c-pmd.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>net.sourceforge.pmd</groupId>
                            <artifactId>pmd-java</artifactId>
                            <version>${pmd.version}</version>
                        </dependency>
                        <!-- PMD 6.55 依赖的 ASM 9.4 无法读取 Java 21 字节码（major 65），不覆盖则全部文件解析失败、门禁形同虚设 -->
                        <dependency>
                            <groupId>org.ow2.asm</groupId>
                            <artifactId>asm</artifactId>
                            <version>${asm.version}</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!--
                    静态缺陷与安全扫描（SKILL 第 8 步）：SpotBugs 找缺陷模式，FindSecBugs 补安全规则。
                    effort=Max + threshold=Low 是「先全看见再决定豁免」的口径：漏报比误报贵得多，
                    误报进 spotbugs-exclude.xml 并写明理由，不放宽阈值。
                -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Low</threshold>
                        <includeTests>true</includeTests>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>${findsecbugs.version}</version>
                            </plugin>
                        </plugins>
                        <excludeFilterFile>${project.basedir}/../spotbugs-exclude.xml</excludeFilterFile>
                        <failOnError>${spotbugs.failOnError}</failOnError>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotbugs-check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!--
                    依赖漏洞门禁（SKILL 第 8 步）：OWASP Dependency-Check。
                    默认 skip（NVD 数据下载耗时）；完整验收与 CI 用
                    -Ddependency-check.skip=false 启用，failBuildOnCVSS=7 阻断。
                    豁免按「CVE + 依赖坐标」写在 dependency-check-suppressions.xml，必须带理由与复查日期。
                -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check-maven.version}</version>
                    <configuration>
                        <skip>${dependency-check.skip}</skip>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <!-- 官方 JSON feeds 2.0：无需 API key，首次下载年度包，之后按 meta 做增量更新 -->
                        <nvdDatafeedUrl>${dependency-check.nvdDatafeedUrl}</nvdDatafeedUrl>
                        <!-- RetireJS 数据源走 jsDelivr 镜像（见 properties 注释）：raw.githubusercontent.com 国内不可达 -->
                        <retireJsUrl>${dependency-check.retireJsUrl}</retireJsUrl>
                        <dataDirectory>${dependency-check.dataDirectory}</dataDirectory>
                        <suppressionFiles>
                            <!--
                                必须用 maven.multiModuleProjectDirectory（仓库根），不能用 ${project.basedir}/../：
                                13 号闸门在仓库根直接调用插件目标，此时 project.basedir 就是根目录，
                                ../ 会越出仓库指向 D:\dependency-check-suppressions.xml 导致初始化失败。
                            -->
                            <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
                        </suppressionFiles>
                    </configuration>
                    <executions>
                        <execution>
                            <id>dependency-check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <!--
                依赖漏洞门禁（SKILL 第 8 步）的启用开关：本 profile 只翻转 dependency-check.skip，
                插件本体在 pluginManagement 中定义、每个模块各自声明——不重复配置任何扫描参数。
                engineering-baseline spec 要求：默认构建不执行，CI 每次合并请求必须执行本 profile；
                CVSS 达到或超过 7 的依赖阻断构建，误报豁免写入 dependency-check-suppressions.xml。
            -->
            <id>security</id>
            <properties>
                <dependency-check.skip>false</dependency-check.skip>
            </properties>
        </profile>
    </profiles>
</project>
