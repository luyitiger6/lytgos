<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.lytgos</groupId>
    <artifactId>lytgos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>lytgos</name>
    <description>企业级 Agent OS 控制面</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <!-- 与 spring-ai-mcp:2.0.2 内部依赖的版本保持一致，便于将来一起升级 -->
        <mcp-sdk.version>2.1.0</mcp-sdk.version>
        <archunit.version>1.4.1</archunit.version>
        <!-- 格式门禁：google-java-format 1.27.0 起支持 JDK 21 -->
        <spotless.version>2.44.5</spotless.version>
        <google-java-format.version>1.27.0</google-java-format.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <!-- p3c-pmd 2.1.1 编译于 PMD 6 API，故插件与 PMD 都锁 6.x 线 -->
        <maven-pmd-plugin.version>3.21.2</maven-pmd-plugin.version>
        <p3c-pmd.version>2.1.1</p3c-pmd.version>
        <pmd.version>6.55.0</pmd.version>
        <!-- PMD 6.55 自带的 ASM 只认到 Java 20 字节码（major 64），读 JDK21 编译产物会整体解析失败，覆盖到 9.7.1 -->
        <asm.version>9.7.1</asm.version>
        <!-- 默认阻断；本地排查存量违规时可用 -Dpmd.failOnViolation=false 先收集全量清单 -->
        <pmd.failOnViolation>true</pmd.failOnViolation>
        <!-- 静态缺陷与安全扫描：SpotBugs + FindSecBugs -->
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <findsecbugs.version>1.14.0</findsecbugs.version>
        <!-- 默认阻断；本地排查存量问题时可用 -Dspotbugs.failOnError=false 先收集全量报告 -->
        <spotbugs.failOnError>true</spotbugs.failOnError>
    </properties>

    <modules>
        <module>lytgos-core</module>
        <module>lytgos-persona</module>
        <module>lytgos-provider</module>
        <module>lytgos-memory</module>
        <module>lytgos-knowledge</module>
        <module>lytgos-tool</module>
        <module>lytgos-storage</module>
        <module>lytgos-channel</module>
        <module>lytgos-web</module>
        <module>lytgos-cli</module>
        <module>lytgos-boot</module>
        <module>lytgos-test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 架构约束测试只需要在 lytgos-test 里以 test scope 使用 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                格式门禁（SKILL 第 7 步）：google-java-format 管「长什么样」。
                check 默认绑定 verify，mvn package / test 不受影响（harness 01/02 依赖这一点）。
                行尾统一交给 .gitattributes（* text=auto eol=lf），与仓库现有约定一致。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <lineEndings>GIT_ATTRIBUTES</lineEndings>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                规约兜底（SKILL 第 7 步）：google_checks.xml 与 google-java-format 同源，
                格式由 gjf 先产出，Checkstyle 只补它没覆盖的检查（Javadoc、命名、圈复杂度）。
                violationSeverity=warning：warning 级违规同样阻构建。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>google_checks.xml</configLocation>
                    <suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</suppressionsLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                编码规约（SKILL 第 7 步）：阿里 P3C 挂在 PMD 上。
                p3c-pmd 2.1.1 只能跑在 PMD 6 API 上，所以 maven-pmd-plugin 选 3.21.2
                （最后一个默认 PMD 6 的版本），并显式锁定 pmd-java 6.55.0。
                ruleset 用仓库内定制版：包含全部 10 组 ali 规则，仅排除 3 条与项目基线
                冲突的规则，理由集中写在 config/pmd/p3c-ruleset.xml 顶部。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <configuration>
                    <targetJdk>20</targetJdk>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/config/pmd/p3c-ruleset.xml</ruleset>
                    </rulesets>
                    <includeTests>true</includeTests>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>${pmd.failOnViolation}</failOnViolation>
                    <linkXRef>false</linkXRef>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.alibaba.p3c</groupId>
                        <artifactId>p3c-pmd</artifactId>
                        <version>${p3c-pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <!-- PMD 6.55 依赖的 ASM 9.4 无法读取 Java 21 字节码（major 65），不覆盖则全部文件解析失败、门禁形同虚设 -->
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>${asm.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                静态缺陷与安全扫描（SKILL 第 8 步）：SpotBugs 找缺陷模式，FindSecBugs 补安全规则。
                effort=Max + threshold=Low 是「先全看见再决定豁免」的口径：漏报比误报贵得多，
                误报进 spotbugs-exclude.xml 并写明理由，不放宽阈值。
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <includeTests>true</includeTests>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                    <failOnError>${spotbugs.failOnError}</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
