            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-provider</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-memory</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-knowledge</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-tool</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
