            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-channel</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-web</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-cli</artifactId>
            <version>${project.version}</version>
