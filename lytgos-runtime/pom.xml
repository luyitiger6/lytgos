<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lytgos-runtime</artifactId>
    <name>lytgos-runtime</name>
    <description>业务装配：工作区、沙箱、持久化、Provider、内置工具与 per-Agent 运行时，供 CLI 与 Web 两个入口共享</description>

    <dependencies>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-persona</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-tool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            持久化由 Spring 容器管理：HikariCP 是 Boot 默认连接池，
            mybatis-spring 提供 SqlSessionFactoryBean 与 @MapperScan。
            spring-jdbc 由 Boot 父 pom 管版本，SqlSessionFactoryBean 的事务依赖它。
        -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!--
            Spring 容器与配置绑定。spring-context / spring-beans / spring-core 已由 spring-ai
            传递引入，这里只补 Binder、@ConfigurationProperties 与 YamlPropertySourceLoader。
            不引 spring-boot-starter：它会多带 autoconfigure（只服务自动配置，本模块不用）
            与 starter-logging（日志后端由使用方 cli / boot 提供）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <!--
            只有注解，不含实现：RuntimePool 用 @PreDestroy 在容器关闭时回收 MCP 子进程。
            spring-context 不传递引入它（Jakarta 注解是可选依赖），runtime 目前又没有
            boot starter，所以必须显式声明，否则 @PreDestroy 编译不过。
        -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                门禁五件套：插件声明在模块里，任一模块在自己的目录即可 `mvn verify` 独立验收；
                版本、配置与 execution 绑定由根 pom 的 pluginManagement 统一提供。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
