<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
      豁免书写规范（新增前必读）：

      1. 每条豁免用 <Match> 限定到「类 + 缺陷模式」，禁止只写 <Bug pattern> 全局放水；
      2. 每个 <Match> 前必须有 XML 注释说明：为什么是误报、什么条件下需要重审；
      3. 豁免的增删同步记录在 openspec/changes/add-quality-gates/design.md 的 D6 豁免台账里，
         保证「为什么放宽」有唯一可审计的出处。

      以下条目来自 2026-11-14 首次全量扫描（effort Max / threshold Low），
      真问题已在代码里修掉，这里只留框架语义导致的误报。
    -->

    <!--
      EI_EXPOSE_REP2：构造器保存外部传入的可变引用。

      这些类保存的是 Spring 容器持有的共享单例（ObjectMapper、ToolRegistry、
      McpSyncClient、OpenAiChatModel、MemoryStore 等），生命周期不短于本类，
      构造器只是转交引用。MemoryStore 是 final 字段、无 mutator 的不可变门面，
      append 只写文件、不改对象状态。逐个防御性拷贝既不现实也没有意义：调用方本来就是容器本身。

      ReActLoop 保存的 PromptBuilder 同理：全字段 final、私有构造器 + 静态工厂，
      没有 mutator，在 AgentRuntimeFactory 内构造后只读，SpotBugs 无法识别这类不可变门面。

      重审条件：类改为自行 new 这些依赖，或允许业务代码传入可变配置对象。
    -->
    <Match>
        <Class name="io.lytgos.cli.AgentRuntimeFactory"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.core.session.FileSessionStore"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.core.tool.ToolExecutor"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.provider.SpringAiChatModel"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.tool.mcp.McpTool"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.cli.CliChannel"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.memory.SaveMemoryTool"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.memory.RecallMemoryTool"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.core.agent.ReActLoop"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!--
      Mapper 是 @MapperScan 生成的代理，由 Spring 容器单例持有；Store 只转交引用、从不替换。
      重审条件：Store 允许外部换 Mapper 或开始持有可变的查询状态。
    -->
    <Match>
        <Class name="io.lytgos.storage.SqliteAuditStore"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="io.lytgos.storage.SqliteSessionStore"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      CRLF_INJECTION_LOGS：本类所有日志参数已经过 LogSafe.sanitize 转义后再输出。

      FindSecBugs 的 taint 分析不识别自定义 sanitizer，因此即使参数已在日志前清洗，仍会报点。
      本类剩下的日志点全部属于这种情况；新增日志如果引入未清洗的外部字符串，本条豁免会一并放行，
      所以 code review 必须人工确认新日志参数也走了 LogSafe.sanitize。

      重审条件：FindSecBugs 支持自定义 sanitizer 标注，或本类日志改为结构化字段输出。
    -->
    <Match>
        <Class name="io.lytgos.tool.mcp.McpServerManager"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      AgentLoader 从 AGENT.md 读出的 agent 名与 provider/model 是 FindSecBugs 的 taint source
      （文件内容），三个值在写日志前都经过 LogSafe.sanitize。理由同上：插件不识别自定义 sanitizer。
      「本轮到底用了哪个 agent、哪个模型」是排查时最先要看的现场，删掉日志比豁免更糟。

      重审条件：新增日志参数未走 LogSafe.sanitize，或 FindSecBugs 支持自定义 sanitizer 标注。
    -->
    <Match>
        <Class name="io.lytgos.persona.AgentLoader"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      ProviderRegistry 输出的是从配置文件绑定的 provider 名与 model（taint source），
      describe() 与 require() 里的值均经 LogSafe.sanitize；FindSecBugs 不识别自定义 sanitizer。
      这两行是「启动时到底认了哪几个 provider」与「首次构造 ChatModel」的现场证据。

      重审条件：新增日志参数未走 LogSafe.sanitize，或 FindSecBugs 支持自定义 sanitizer 标注。
    -->
    <Match>
        <Class name="io.lytgos.provider.ProviderRegistry"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      MemoryStore.append 的 file 参数可能来自模型工具入参（taint source），写日志前经 LogSafe.sanitize；
      同文件自身的读写路径不构成注入面（单进程、路径已由 SandboxChecker 校验）。

      重审条件：新增日志参数未走 LogSafe.sanitize，或 FindSecBugs 支持自定义 sanitizer 标注。
    -->
    <Match>
        <Class name="io.lytgos.memory.MemoryStore"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      SqliteSessionStore.save 的 key 来自会话标识（CLI 拼接 / Web 请求），写日志前经 LogSafe.sanitize；
      messages 是整数。两者都不构成日志伪造面。

      重审条件：新增日志参数未走 LogSafe.sanitize，或 FindSecBugs 支持自定义 sanitizer 标注。
    -->
    <Match>
        <Class name="io.lytgos.storage.SqliteSessionStore"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      THROWS_METHOD_THROWS_RUNTIMEEXCEPTION：catch 后原样 rethrow 被识别成「故意抛 RuntimeException」。

      这些都是「先清理再抛出」的失败路径：catch (RuntimeException e) 里先 close 半启动资源
      或补齐会话历史，然后 throw e 保留原始堆栈。转成受检异常或包装成新异常都会丢堆栈，
      反而降低可诊断性。

      重审条件：这些 catch 块开始构造新的 RuntimeException 而不是 rethrow 原异常。
    -->
    <Match>
        <Class name="io.lytgos.cli.AgentRuntimeFactory"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <Match>
        <Class name="io.lytgos.cli.LazyContext"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <Match>
        <Class name="io.lytgos.core.agent.ReActLoop"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <Match>
        <Class name="io.lytgos.provider.AuditedChatModel"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <Match>
        <Class name="io.lytgos.tool.mcp.McpServerManager"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>

    <!--
      COMMAND_INJECTION：ShellTool 就是「受控命令执行」能力本身，命令来自模型但必须过白名单。

      补偿措施：execute 先把可执行文件名交给 SandboxChecker.checkCommand，不在
      allowed-commands 内直接抛 SandboxViolationException；ProcessBuilder 用 List 形式且不经系统 shell，
      ; | > 只作为普通参数；参数切分复用与校验相同的规则（裸命令 / 带路径 / 引号包裹），
      不存在「校验按 A 解析、执行按 B 解析」的缺口。FindSecBugs 看不到自定义白名单与不经 shell 的事实。
      ShellToolTest 的同类报点来自测试夹具故意执行 java（参数是测试常量，不来自外部输入）。

      重审条件：ShellTool 改为经过系统 shell 执行，或白名单校验移到 execute 之外。
    -->
    <Match>
        <Class name="io.lytgos.tool.ShellTool"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>
    <Match>
        <Class name="io.lytgos.tool.ShellToolTest"/>
        <Bug pattern="COMMAND_INJECTION"/>
    </Match>

    <!--
      VA_FORMAT_STRING_USES_NEWLINE：text block 作为「文件内容模板」时，换行是内容而不是控制台格式。

      AGENT.md 模板与测试里的 YAML 夹具都用 text block 拼文件内容，换行跟随源码的 LF；
      改成 %n 会让同一份模板在 Windows 上产出 CRLF，与仓库 LF 口径冲突。

      重审条件：这些 text block 改为直接输出到控制台。
    -->
    <Match>
        <Class name="io.lytgos.cli.ProfileCommand$Create"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <Match>
        <Class name="io.lytgos.cli.WorkspaceConfigProviderTest"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!--
      NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE：Binder.bind(...) 的返回值按 Spring 契约不会为 null，
      .orElse(...) 已经覆盖「未绑定」的情况；SpotBugs 没有该方法的 @NonNull 注解可依据。

      重审条件：Spring Boot 升级后 Binder 契约变化，或该处改为 chain 上的第三方方法。
    -->
    <Match>
        <Class name="io.lytgos.cli.WorkspaceConfigProvider"/>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <!--
      SPRING_ENDPOINT：Spring 控制器的「信息性提示」，不是缺陷。

      FindSecBugs 对每个 @Controller / @RestController 都报一条，提醒人工检查该端点，
      它本身不指向任何具体风险。lytgos 的端点只返回只读数据或统一 404，没有表单与会话。
      按类逐条登记而不是按包放水：新增控制器时必须单独决定是否豁免，强制过一次人工确认。
      测试桩控制器只经 standaloneSetup / 随机端口装载，不进入任何可执行入口。

      重审条件：该控制器引入状态变更端点（写库、发消息、扣配额）时，逐方法复核。
    -->
    <Match>
        <Class name="io.lytgos.web.api.ApiNotFoundController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="io.lytgos.web.api.SystemInfoController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="io.lytgos.web.error.GlobalExceptionHandlerTest$StubController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Class name="io.lytgos.web.trace.TraceIdFilterTest$StubController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!--
      SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING：通配 404 处理器不是「未限制方法的状态变更端点」。

      ApiNotFoundController 承接 /api 与 /api/** 的所有 HTTP 方法，只为把「路径不存在」
      统一成 LYTGOS_NOT_FOUND；它不读请求体、不写任何状态，CSRF 没有可触发的副作用。
      精确映射的优先级高于通配，真实端点不会被它截获。

      重审条件：该处理器开始读取请求体 / 会话，或改为 catch-all 过滤器与拦截器。
    -->
    <Match>
        <Class name="io.lytgos.web.api.ApiNotFoundController"/>
        <Bug pattern="SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING"/>
    </Match>

    <!--
      SERVLET_HEADER：读取调用方传入的 X-Request-Id 是 observability spec 明文要求的行为。

      头部可被篡改是事实，因此 traceId 在写入 MDC 与响应头之前先净化（剔控制字符、截断 128），
      不会把外部输入原样拼进日志。伪造 traceId 只影响该请求自身的可追踪性，不放大任何权限。

      重审条件：traceId 被用于鉴权、审计归属或跨服务的信任边界。
    -->
    <Match>
        <Class name="io.lytgos.web.trace.TraceIdFilter"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <!--
      TraceIdFilter 的探针行参数（HTTP 方法、请求 URI）来自请求行，属于 taint source；
      两者写日志前都经 LogSafe.sanitize。理由同上：插件不识别自定义 sanitizer。
      这一行是闸门 12 判据 1/3 的锚点（dev 业务 DEBUG 可见 / 请求 traceId 落到日志），不能删。

      重审条件：探针行新增未净化的参数，或闸门 12 改为依赖框架日志。
    -->
    <Match>
        <Class name="io.lytgos.web.trace.TraceIdFilter"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
      THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION：JUnit 测试方法声明 throws Exception 是标准写法。

      测试方法不由生产调用方调用，收窄 throws 没有收益；RestClient 调用与 JSON 解析都可能抛受检异常。

      重审条件：该断言逻辑被提取进生产类。
    -->
    <Match>
        <Class name="io.lytgos.web.api.SystemInfoIntegrationTest"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

</FindBugsFilter>
