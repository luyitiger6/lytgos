<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lytgos-channel</artifactId>
    <name>lytgos-channel</name>
    <description>渠道适配器：命令行、飞书、企微、钉钉等入口的统一落点</description>

    <dependencies>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-persona</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-tool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>lytgos-channel</finalName>
        <plugins>
            <!--
                classifier=boot：可执行 fat jar 作为附加产物（lytgos-channel-boot.jar），
                主 artifact 保持普通 jar，否则被 lytgos-boot 依赖时拿到 BOOT-INF 结构。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.lytgos.channel.CliChannelApplication</mainClass>
                    <classifier>boot</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
