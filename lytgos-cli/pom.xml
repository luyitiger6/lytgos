<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>lytgos-cli</artifactId>
    <name>lytgos-cli</name>
    <description>命令行入口：子命令解析与运行模式选择</description>

    <dependencies>
        <!-- 业务装配下沉在 lytgos-runtime；下面六个业务模块是 CLI 命令直接引用到的类型 -->
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- serve 子命令：REST 端点与管理台都编译在 lytgos-web，入口只负责把它拉起来。
             反向不成立（web 不依赖 cli），否则入口层会被库引用。 -->
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- serve 的 Servlet 容器与自动配置；CLI 其余子命令走懒启动（LazyContext），
             不碰这里的任何类，version / help 两条命令的启动预算不受影响。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-persona</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-tool</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lytgos</groupId>
            <artifactId>lytgos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            持久化由 Spring 容器管理：HikariCP 是 Boot 默认连接池，
            mybatis-spring 提供 SqlSessionFactoryBean 与 @MapperScan。
            spring-jdbc 由 Boot 父 pom 管版本，SqlSessionFactoryBean 的水事务依赖它。
        -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- Spring 容器与配置绑定。spring-context / spring-beans / spring-core 已由 spring-ai
             传递引入，这里只补 Binder、@ConfigurationProperties 与 YamlPropertySourceLoader。
             不引 spring-boot-starter：它会多带 autoconfigure（只服务自动配置，本项目不用）
             与 starter-logging（与下面的 logback-classic 重复）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
        </dependency>
        <!-- 日志实现。core 只用 slf4j-api，由运行方决定后端；
             第 3 周 lytgos-boot 引入 spring-boot-starter 后这份依赖会变冗余，届时删掉 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>lytgos-cli</finalName>
        <plugins>
            <!--
                门禁五件套：插件声明在模块里，任一模块在自己的目录即可 `mvn verify` 独立验收；
                版本、配置与 execution 绑定由根 pom 的 pluginManagement 统一提供。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
            </plugin>
            <!--
                classifier=boot：可执行 fat jar 作为附加产物（lytgos-cli-boot.jar），
                主 artifact 保持普通 jar，否则被 lytgos-channel 依赖时会拿到
                BOOT-INF 结构、编译期找不到类。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.lytgos.cli.LytgosCli</mainClass>
                    <classifier>boot</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
