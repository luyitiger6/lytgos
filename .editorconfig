root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java 统一 Google 风格：2 空格缩进（google-java-format GOOGLE）
[*.java]
indent_style = space
indent_size = 2

[*.{xml,yml,yaml,json,jsonc}]
indent_style = space
indent_size = 4

# Markdown 的两个行尾空格表示硬换行，不能裁剪
[*.md]
trim_trailing_whitespace = false
indent_size = 4

# PowerShell 脚本需要 UTF-8 BOM，Windows PowerShell 5.1 才不会把中文读成乱码
[*.{ps1,psm1}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4
